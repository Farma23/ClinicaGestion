@model IEnumerable<ClinicaGestion.Models.Patient>
@{ ViewBag.Title = "Pacientes"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Lista de Pacientes</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo Paciente</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Nombre Completo</th>
                        <th>Fecha de Nacimiento</th>
                        <th>Telefono</th>
                        <th>Direccion</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.FullName</td>
                            <td>@p.DateOfBirth.ToString("dd/MM/yyyy")</td>
                            <td>@p.PhoneNumber</td>
                            <td>@p.Address</td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-info text-white me-1">Ver</a>
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning me-1">Editar</a>
                                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <p>No hay pacientes registrados.</p>
                <a asp-action="Create" class="btn btn-primary">Registrar el primero</a>
            </div>
        }
    </div>
</div>
<p class="text-muted mt-2"><small>Total: @Model.Count() paciente(s)</small></p>
